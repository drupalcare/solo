{% set bottom_first = page.bottom_first is not empty ? page.bottom_first : null %}
{% set bottom_second = page.bottom_second is not empty ? page.bottom_second : null %}
{% set bottom_third = page.bottom_third is not empty ? page.bottom_third : null %}
{% set bottom_fourth = page.bottom_fourth is not empty ? page.bottom_fourth : null %}

{% if bottom_first or bottom_second or bottom_third or bottom_fourth %}

{% set bottom_regions = 0 %}

{% if bottom_first %}
  {% set bottom_regions = bottom_regions + 1 %}
  {% set bottom_first_outer_classes = 'solo-region-box solo-region-box--bottom solo-region-box--bottom-first' %}
  {% set bottom_first_inner_classes = 'solo-region-box__inner solo-region-box__inner--bottom solo-region-box__inner--bottom-first solo-fade-target' ~ (align_bottom_first ? ' ' ~ align_bottom_first) ~ (classes_bottom_first ? ' ' ~ classes_bottom_first) %}
{% endif %}

{% if bottom_second %}
  {% set bottom_regions = bottom_regions + 1 %}
  {% set bottom_second_outer_classes = 'solo-region-box solo-region-box--bottom solo-region-box--bottom-second' %}
  {% set bottom_second_inner_classes = 'solo-region-box__inner solo-region-box__inner--bottom solo-region-box__inner--bottom-second solo-fade-target' ~ (align_bottom_second ? ' ' ~ align_bottom_second) ~ (classes_bottom_second ? ' ' ~ classes_bottom_second) %}
{% endif %}

{% if bottom_third %}
  {% set bottom_regions = bottom_regions + 1 %}
  {% set bottom_third_outer_classes = 'solo-region-box solo-region-box--bottom solo-region-box--bottom-third' %}
  {% set bottom_third_inner_classes = 'solo-region-box__inner solo-region-box__inner--bottom solo-region-box__inner--bottom-third solo-fade-target' ~ (align_bottom_third ? ' ' ~ align_bottom_third) ~ (classes_bottom_third ? ' ' ~ classes_bottom_third) %}
{% endif %}

{% if bottom_fourth %}
  {% set bottom_regions = bottom_regions + 1 %}
  {% set bottom_fourth_outer_classes = 'solo-region-box solo-region-box--bottom solo-region-box--bottom-fourth' %}
  {% set bottom_fourth_inner_classes = 'solo-region-box__inner solo-region-box__inner--bottom solo-region-box__inner--bottom-fourth solo-fade-target' ~ (align_bottom_fourth ? ' ' ~ align_bottom_fourth) ~ (classes_bottom_fourth ? ' ' ~ classes_bottom_fourth) %}
{% endif %}

{% set bottom_active = 'solo-container--bottom-active-' ~ bottom_regions %}

{% set bottom_outer = 'solo-outer solo-container--multi solo-container--bottom' ~
  (bottom_active ? ' ' ~ bottom_active) ~
  (site_regions_bottom_border ? ' solo-container--has-border') ~
  (site_regions_bottom_rounded ? ' ' ~ site_regions_bottom_rounded) ~
  (site_regions_bottom_animate_border ? ' solo-container--animate-border') ~
  (site_regions_bottom_animate_hover ? ' solo-container--animate-hover') ~
  (classes_bottom_container ? ' ' ~ classes_bottom_container) %}

{% set bottom_inner = 'solo-inner solo-col solo-container__inner--bottom' ~
  (bottom_layout ? ' ' ~ bottom_layout) %}

  <!-- Start: Bottom Container -->
  <div id="solo-bottom-container"{% if enable_aria_bottom %} role="region" aria-label="{{ 'Bottom Section'|t }}"{% endif %} class="{{ bottom_outer }}" {{ attributes_bottom_container }}>

    <div id="solo-bottom-container-inner" class="{{ bottom_inner }}">

    {% if bottom_first %}
      <!-- Start: Bottom First -->
      <div id="solo-bottom-box-first" class="{{ bottom_first_outer_classes }}">
        <div class="{{ bottom_first_inner_classes }}" {{ attributes_bottom_first }}>
          {{ bottom_first }}
        </div>
      </div>
      <!-- End: Bottom First -->
    {% endif %}

    {% if bottom_second %}
      <!-- Start: Bottom Second -->
      <div id="solo-bottom-box-second" class="{{ bottom_second_outer_classes }}">
        <div class="{{ bottom_second_inner_classes }}" {{ attributes_bottom_second }}>
          {{ bottom_second }}
        </div>
      </div>
      <!-- End: Bottom Second -->
    {% endif %}

    {% if bottom_third %}
      <!-- Start: Bottom Third -->
      <div id="solo-bottom-box-third" class="{{ bottom_third_outer_classes }}">
        <div class="{{ bottom_third_inner_classes }}" {{ attributes_bottom_third }}>
          {{ bottom_third }}
        </div>
      </div>
      <!-- End: Bottom Third -->
    {% endif %}

    {% if bottom_fourth %}
      <!-- Start: Bottom Fourth -->
      <div id="solo-bottom-box-fourth" class="{{ bottom_fourth_outer_classes }}">
        <div class="{{ bottom_fourth_inner_classes }}" {{ attributes_bottom_fourth }}>
          {{ bottom_fourth }}
        </div>
      </div>
      <!-- End: Bottom Fourth -->
    {% endif %}

    </div>
  </div>
  <!-- End: Bottom -->
{% endif %}
