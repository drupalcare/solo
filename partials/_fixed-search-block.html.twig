{% if page.fixed_search_block %}
  {{ attach_library('solo/component-fixed-search-block') }}
  <div id="solo-fixed-search-block"
       class="solo-outer solo-container--single solo-fixed-search-block{{ classes_fixed_search_block ? ' ' ~ classes_fixed_search_block }}"
       role="search"
       aria-label="{{ 'Search form'|t }}"
       aria-hidden="true"
       inert
       {{ attributes_fixed_search_block }}>
    <div id="solo-fixed-search-block-inner" class="solo-inner solo-col solo-col-1 solo-fixed-search-block__inner">
      <div class="solo-fixed-search-block__wrapper">
        <div id="solo-fixed-search-block__close" class="solo-hamburger solo-hamburger--close solo-fixed-search-block__close">
          {# Button for closing the search form - initially not focusable #}
          <button type="button"
                  class="solo-btn-animate solo-button-menu"
                  data-drupal-selector="solo-fixed-search-block__close-inner"
                  aria-label="{{ 'Close search'|t }}"
                  aria-controls="solo-fixed-search-block"
                  aria-expanded="false"
                  tabindex="-1">
            <span aria-hidden="true">{{ svg_bars|raw }}</span>
            <span class="visually-hidden">{{ 'Close search'|t }}</span>
          </button>
        </div>
        {{ page.fixed_search_block }}
      </div>
    </div>
  </div>
{% endif %}
