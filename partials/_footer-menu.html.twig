  {% if page.footer_menu or sm_show_icons %}
    <!-- Start: Footer Menu -->
    <div id="solo-footer-menu" class="solo-outer solo-container--single solo-footer-menu__nav{{ classes_footer_menu ? ' ' ~ classes_footer_menu }}" {{ attributes_footer_menu }}>
      <div id="solo-footer-menu-inner" class="solo-inner solo-col solo-col-1 solo-footer-menu__nav__inner">

    {% if sm_show_icons %}
      <!-- Start: Social Media -->
      <div class="solo-clear solo-fade-target solo-footer-menu__nav__first solo-social{{ sm_icon_size ? ' ' ~ sm_icon_size }}" {% if sm_icon_colors %} style="fill: {{ sm_icon_colors }}" {% endif %}>
        {% set socials = {
        'facebook': {'url': sm_icon_facebook},
        'instagram': {'url': sm_icon_instagram},
        'twitter': {'url': sm_icon_twitter},
        'bluesky': {'url': sm_icon_bluesky},
        'linkedin': {'url': sm_icon_linkedin},
        'youtube': {'url': sm_icon_youtube},
        'pinterest': {'url': sm_icon_pinterest},
        'snapchat': {'url': sm_icon_snapchat},
        'reddit': {'url': sm_icon_reddit},
        'tiktok': {'url': sm_icon_tiktok},
        'whatsapp': {'url': sm_icon_whatsapp},
        'telegram': {'url': sm_icon_telegram},
        'mastodon': {'url': sm_icon_mastodon},
        'drupal': {'url': sm_icon_drupal},
        'threads': {'url': sm_icon_threads},
        'rss': {'url': sm_icon_rss},
        'email': {'url': sm_icon_email},
        } %}
        {% for key, social in socials %}
          {% if social.url %}
            {# Brand names stay as written; the word Email is translated. #}
            {% set social_label = key == 'email' ? 'Email'|t : key|capitalize %}
            {% if key == 'email' %}
              <a href="mailto:{{ social.url }}" title="{{ social_label }}" class="solo-clear {{ key }}">
            {% else %}
              <a href="{{ social.url }}" title="{{ social_label }}" class="solo-clear {{ key }}" target="_blank" rel="noopener noreferrer">
            {% endif %}
                <span class="solo-social__icon" aria-hidden="true">
                  {% set svg_icon = "@solo/partials/svg/_svg-" ~  key   ~ ".html.twig" %}
                  {% include svg_icon %}
                </span>
                <span class="visually-hidden">{{ social_label }}{% if key != 'email' %} {{ '(opens in a new tab)'|t }}{% endif %}</span>
              </a>
          {% endif %}
        {% endfor %}
      </div>
      <!-- End: Social Media -->
    {% endif %}

        <!-- Start: Bottom Menu -->
        {% if page.footer_menu %}
          <div class="solo-clear solo-footer-menu__nav__second solo-fade-target">
            {% if enabled_skip_links.skip_footer_content %}
              <a id="solo-footer-content" tabindex="-1" class="solo-skip-target"></a>
            {% endif %}
            {{ page.footer_menu }}
          </div>
          <!-- End: Bottom Menu -->
        {% endif %}
      </div>
    </div>
    <!-- End: Footer Menu -->
  {% endif %}
