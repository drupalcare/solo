{% set footer_first = page.footer_first is not empty ? page.footer_first : null %}
{% set footer_second = page.footer_second is not empty ? page.footer_second : null %}
{% set footer_third = page.footer_third is not empty ? page.footer_third : null %}

{% if footer_first or footer_second or footer_third %}

{% set footer_regions = 0 %}

{% if footer_first%}
  {% set footer_regions = footer_regions + 1 %}
  {% set footer_first_outer_classes = 'solo-region-box solo-region-box--footer solo-region-box--footer-first' %}
  {% set footer_first_inner_classes = 'solo-region-box__inner solo-region-box__inner--footer solo-region-box__inner--footer-first solo-fade-target' ~ (align_footer_first ? ' ' ~ align_footer_first) ~ (classes_footer_first ? ' ' ~ classes_footer_first) %}
{% endif %}

{% if footer_second %}
  {% set footer_regions = footer_regions + 1 %}
  {% set footer_second_outer_classes = 'solo-region-box solo-region-box--footer solo-region-box--footer-second' %}
  {% set footer_second_inner_classes = 'solo-region-box__inner solo-region-box__inner--footer solo-region-box__inner--footer-second solo-fade-target' ~ (align_footer_second ? ' ' ~ align_footer_second) ~ (classes_footer_second ? ' ' ~ classes_footer_second) %}
{% endif %}

{% if footer_third %}
  {% set footer_regions = footer_regions + 1 %}
  {% set footer_third_outer_classes = 'solo-region-box solo-region-box--footer solo-region-box--footer-third' %}
  {% set footer_third_inner_classes = 'solo-region-box__inner solo-region-box__inner--footer solo-region-box__inner--footer-third solo-fade-target' ~ (align_footer_third ? ' ' ~ align_footer_third) ~ (classes_footer_third ? ' ' ~ classes_footer_third) %}
{% endif %}

{% set footer_active = 'solo-container--footer-active-' ~ footer_regions %}

{% set footer_outer = 'solo-outer solo-container--multi solo-container--footer' ~
  (footer_active ? ' ' ~ footer_active) ~
  (site_regions_footer_border ? ' solo-container--has-border') ~
  (site_regions_footer_rounded ? ' ' ~ site_regions_footer_rounded) ~
  (site_regions_footer_animate_border ? ' solo-container--animate-border') ~
  (site_regions_footer_animate_hover ? ' solo-container--animate-hover') ~
  (classes_footer_container ? ' ' ~ classes_footer_container) %}

{% set footer_inner = 'solo-inner solo-col solo-container__inner--footer' ~
  (footer_layout ? ' ' ~ footer_layout) %}

  <!-- Start: Footer -->
  <div id="solo-footer-container"{% if enable_aria_footer %} role="region" aria-label="{{ 'Footer Section'|t }}"{% endif %} class="{{ footer_outer }}" {{ attributes_footer_container }}>
    <div id="solo-footer-container-inner" class="{{ footer_inner }}">

    {% if footer_first %}
      <!-- Start: Footer First  -->
      <div id="solo-footer-box-first" class="{{ footer_first_outer_classes }}">
        <div class="{{ footer_first_inner_classes }}" {{ attributes_footer_first }}>
          {{ footer_first }}
        </div>
      </div>
      <!-- End: Footer First -->
    {% endif %}

    {% if footer_second %}
      <!-- Start: Footer Second Region -->
      <div id="solo-footer-box-second" class="{{ footer_second_outer_classes }}">
        <div class="{{ footer_second_inner_classes }}" {{ attributes_footer_second }}>
          {{ footer_second }}
        </div>
      </div>
      <!-- End: Footer Second -->
    {% endif %}

    {% if footer_third %}
      <!-- Start: Footer Third -->
      <div id="solo-footer-box-third" class="{{ footer_third_outer_classes }}">
        <div class="{{ footer_third_inner_classes }}" {{ attributes_footer_third }}>
          {{ footer_third }}
        </div>
      </div>
      <!-- End: Footer Third -->
    {% endif %}

    </div>
  </div>
  <!-- End: Footer -->
{% endif %}
