{% set main_left = page.sidebar_first is not empty ? page.sidebar_first : null %}
{% set main_middle = page.content is not empty ? page.content : null %}
{% set main_right = page.sidebar_second is not empty ? page.sidebar_second : null %}

{% if main_left or main_middle or main_right %}

{% set main_regions = 0 %}
{% if main_left %}
  {% set main_regions = main_regions + 1 %}
  {% set sidebar_first_outer_classes = 'solo-region-box solo-region-box--main solo-region-box--main-sides solo-region-box--sidebar-first' %}
  {% set sidebar_first_inner_classes = 'solo-region-box__inner solo-region-box__inner--main solo-region-box__inner--sidebar-first solo-fade-target' ~ (align_sidebar_first ? ' ' ~ align_sidebar_first) ~ (classes_sidebar_first ? ' ' ~ classes_sidebar_first) %}
{% endif %}

{% if main_middle %}
  {% set main_regions = main_regions + 1 %}
  {% set content_outer_classes = 'solo-region-box solo-region-box--main solo-region-box--content' %}
  {% set content_inner_classes = 'solo-region-box__inner solo-region-box__inner--main solo-region-box__inner--content solo-fade-target' ~ (align_content ? ' ' ~ align_content) ~ (classes_content ? ' ' ~ classes_content) %}
{% endif %}

{% if main_right %}
  {% set main_regions = main_regions + 1 %}
  {% set sidebar_second_outer_classes = 'solo-region-box solo-region-box--main solo-region-box--main-sides solo-region-box--sidebar-second' %}
  {% set sidebar_second_inner_classes = 'solo-region-box__inner solo-region-box__inner--main solo-region-box__inner--sidebar-second solo-fade-target' ~ (align_sidebar_second ? ' ' ~ align_sidebar_second) ~ (classes_sidebar_second ? ' ' ~ classes_sidebar_second) %}
{% endif %}

{% set main_active = 'solo-container--main-active-' ~ main_regions %}

{% set main_outer = 'solo-outer solo-container--multi solo-container--main' ~
  (main_active ? ' ' ~ main_active) ~
  (site_regions_main_border ? ' solo-container--has-border') ~
  (site_regions_main_rounded ? ' ' ~ site_regions_main_rounded) ~
  (classes_main_container ? ' ' ~ classes_main_container)
%}

{% set main_inner = 'solo-inner solo-col solo-container__inner--main' ~
  (main_layout ? ' ' ~ main_layout) ~
  (main_layout_order ? ' ' ~ main_layout_order)
%}

  <!-- Start: Main -->
  <div id="solo-main-container" class="{{ main_outer }}" {{ attributes_main_container }}>
    <div id="solo-main-container-inner" class="{{ main_inner }}">
      <!-- Start: Main Container -->

    {% if main_left %}
      <!-- Start: Left SideBar -->
      <aside id="solo-sidebar-box-first" class="{{ sidebar_first_outer_classes }}" aria-label="{{ 'Sidebar First'|t }}">
        <div class="{{ sidebar_first_inner_classes }}" {{ attributes_sidebar_first }}>
          {{ main_left }}
        </div>
      </aside>
      <!-- End: Left SideBar -->
    {% endif %}

    {% if main_middle %}
      <!-- Start: Main Content -->
      <main id="solo-sidebar-box-main" class="{{ content_outer_classes }}">
        <div class="{{ content_inner_classes }}" {{ attributes_content }}>
          {% if enabled_skip_links.skip_main_content %}
          <a id="main-content" tabindex="-1" class="solo-skip-target"></a>
          {% endif %}
          {{ main_middle }}
        </div>
      </main>
      <!-- End: Main Content -->
    {% endif %}

    {% if main_right %}
      <!-- Start: Right SideBar -->
      <aside id="solo-sidebar-box-second" class="{{ sidebar_second_outer_classes }}" aria-label="{{ 'Sidebar Second'|t }}">
        <div class="{{ sidebar_second_inner_classes }}" {{ attributes_sidebar_second }}>
          {{ main_right }}
        </div>
      </aside>
      <!-- End: Right SideBar -->
    {% endif %}

      <!-- End: Main Container -->
    </div>
  </div>
<!-- End: Main -->
{% endif %}
