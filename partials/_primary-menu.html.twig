  {% if page.primary_menu %}
    <!-- Start: Primary Menu -->
    <div id="solo-primary-menu" class="solo-outer solo-container--single solo-main-nav solo-primary-menu{{ primary_menu_border ? ' solo-container--has-border'}}{{ primary_menu_justify_content ? ' menu--justify'}}{{ classes_primary_menu ? ' ' ~ classes_primary_menu }}" role="navigation" aria-label="{{ 'Main Navigation'|t }}"{{ attributes_primary_menu }}>
      <div id="solo-primary-menu-inner" class="solo-inner solo-col solo-col-1 solo-primary-menu__inner">
        {% if enabled_skip_links.skip_navigation_content %}
        <a id="solo-main-navigation-content" tabindex="-1" class="solo-skip-target"></a>
        {% endif %}
        {{ page.primary_menu }}
      </div>
    </div>
    <!-- End: Primary Menu -->
  {% endif %}
