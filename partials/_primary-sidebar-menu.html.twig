  {% if page.primary_sidebar_menu %}
  <!-- Start: Primary Sidebar Menu  -->
  <div id="solo-primary-sidebar-menu" class="solo-outer solo-container--single solo-main-nav solo-primary-sidebar-menu solo-hamburger{{ header_change_icons ? ' solo-icons-left' }}{{ primary_sidebar_menu_border ? ' solo-container--has-border'}}{{ classes_primary_sidebar_menu ? ' ' ~ classes_primary_sidebar_menu }}" role="navigation" aria-hidden="true"  aria-label="{{ 'Primary Sidebar Menu'|t }}" {{ attributes_primary_sidebar_menu }}>
    <div id="solo-primary-sidebar-menu-inner" class="solo-inner solo-primary-sidebar-menu__inner">

      <div id="solo-sidebar-button-close" class="solo-sidebar-menu__close{{ header_change_icons ? ' solo-icons-left' }}{{ primary_sidebar_menu_branding ? ' solo-menu--has-branding' }}">
        {# <i class="fa fa-close"></i> #}
          <button class="solo-btn-animate solo-button-menu solo-hamburger solo-hamburger--close" data-drupal-selector="solo-hamburger--sidebar" aria-label="{{ 'Close Primary Sidebar Menu'|t }}" aria-controls="solo-primary-sidebar-menu" aria-expanded="false">
              <span aria-hidden="true">{{ svg_bars|raw }}</span>
              <span class="visually-hidden">{{ 'Close Primary Sidebar Menu'|t }}</span>
          </button>
          {% if primary_sidebar_menu_branding %}
          {% include '@solo/partials/_menu-branding.html.twig' %}
          {% endif %}
      </div>
      {{ page.primary_sidebar_menu }}
    </div>
  </div>
  <!-- End: Primary Sidebar Menu -->
{% endif %}
