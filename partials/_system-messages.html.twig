  {% if page.system_messages %}
    <!-- Start: System Messages -->
    <div id="solo-status-messages" role="region" aria-label="{{ 'System Messages'|t }}" class="solo-outer solo-container--single solo-status-messages{{ classes_system_messages ? ' ' ~ classes_system_messages }}" {{ attributes_system_messages }}>
      <div id="solo-system-messages-inner" class="solo-inner solo-col solo-col-1 solo-status-messages__inner">
        {{ page.system_messages }}
      </div>
    </div>
    <!-- End: System Messages -->
  {% endif %}
