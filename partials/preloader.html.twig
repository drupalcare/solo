{#
  Preloader overlay. Inline style built in preprocess from theme settings (same as region colors).
  Markup in Twig (not JS) to avoid FOUC. Critical CSS in head for immediate display.
  Variables: preloader_config, preloader_inline_style.
#}
<div id="solo-preloader"
  class="solo-preloader solo-preloader--{{ preloader_config.style|default('spinner') }}{{ preloader_config.text_font ? ' ' ~ preloader_config.text_font : '' }}"
  role="status"
  aria-live="polite"
  aria-label="{{ 'Page is loading'|t }}"
  data-force-show="{{ preloader_config.force_show ? 'true' : 'false' }}"
  {% if preloader_inline_style is not empty %}style="{{ preloader_inline_style }}"{% endif %}>
  <span class="visually-hidden">{{ 'Loading...'|t }}</span>
  <div class="solo-preloader__inner">
    {% if preloader_config.style == 'logo' and preloader_config.logo_url %}
      <img class="solo-preloader__logo" src="{{ preloader_config.logo_url }}" alt="" width="160" height="80" loading="eager" decoding="sync">
    {% elseif preloader_config.style == 'text' and preloader_config.text is not empty %}
      <span class="solo-preloader__text{{ preloader_config.text_animate ? ' solo-preloader__text--animate' : '' }}" {% if preloader_config.text_font_size %}style="font-size: {{ preloader_config.text_font_size }}px"{% endif %}>{{ preloader_config.text }}</span>
    {% else %}
      <div class="solo-preloader__spinner"></div>
    {% endif %}
  </div>
</div>
