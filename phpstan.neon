# PHPStan configuration for the Solo theme.
#
# Solo's only PHP is solo.post_update.php and the empty tombstones in src/Hook;
# its logic and its strict gate are in the Solo Utilities module. Level 5 stays
# because this file covers Solo's tests too.
parameters:
  level: 5
  paths:
    - src
    - tests
    - solo.post_update.php
  excludePaths:
    # A theme has no vendor/ of its own -- composer installs into the SITE's
    # vendor dir. The (?) marker is REQUIRED: PHPStan treats a missing
    # excludePath as a fatal config error and analyses nothing at all.
    - vendor (?)
  treatPhpDocTypesAsCertain: false
