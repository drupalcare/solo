{#
/**
 * @file
 * Theme override for the search page form (search_form).
 *
 * Same markup as form.html.twig; it also loads Solo's search styles, which
 * exist only when the Search module is installed.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}
{% set classes = [
    'solo-clear',
  ]
%}
{{ attach_library('solo/component-search-block') }}
{{ attach_library('solo/component-search-page') }}
<form{{ attributes.addClass(classes) }}>
  {{ children }}
</form>
