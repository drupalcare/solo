{#
/**
 * @file
 * Override of system/menu.html.twig for a sidebar menu.
 */
#}

{% import _self as menus %}

{# Call the macro to render the full menu tree. #}
{{ menus.menu_links(items, 0, attributes) }}

{% macro menu_links(items, menu_level, attributes) %}
  {% import _self as menus %}

  {% if items %}
    <ul{% if menu_level == 0 %} class="solo-side-menu" role="menubar"{% else %} class="solo-side-menu__sublist" role="menu"{% endif %}>
      {% for item in items %}
        {%
          set item_classes = [
            'solo-side-menu__item',
            item.is_expanded ? 'expanded' : '',
            item.in_active_trail ? 'active active-trail' : '',
          ]
        %}

        {% set link_attributes = create_attribute() %}

        {% if item.url.getOption('attributes') %}
          {% set link_attributes = link_attributes.merge(create_attribute(item.url.getOption('attributes'))) %}
        {% endif %}

        {% set link_attributes = link_attributes.addClass(item.in_active_trail ? 'solo-current' : '') %}

        <li{{ attributes.addClass(item_classes) }} role='none'>
          <a href="{{ item.url }}" {{ link_attributes.setAttribute('role', 'menuitem') }}>
            {{ item.title }}
          </a>
          {% if item.below %}
            {{ menus.menu_links(item.below, menu_level + 1, attributes) }}
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}
